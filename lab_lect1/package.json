{
  "name": "latency-hiding-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client/server latency hiding lab for Distributed Systems.",
  "scripts": {
    "start": "uv run python -m latency_lab.server",
    "start:proxy": "uv run python -m latency_lab.proxy",
    "demo": "uv run python -m latency_lab.demo",
    "test": "uv run pytest",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "bench": "uv run python -m latency_lab.benchmark"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
